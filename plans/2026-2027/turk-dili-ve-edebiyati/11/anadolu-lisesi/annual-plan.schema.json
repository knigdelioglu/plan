                "properties": {
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source_cell_range": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_merged": {
                    "type": "boolean"
                  }
                }
              },
              "differentiation": {
                "type": "object",
                "required": [
                  "text",
                  "source_cell_range",
                  "is_merged"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "source_cell_range": {
                    "type": "string"
                  },
                  "is_merged": {
                    "type": "boolean"
                  }
                }
              },
              "school_based_planning_framework": {
                "type": "object",
                "required": [
                  "text",
                  "source_cell_range",
                  "is_merged"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "source_cell_range": {
                    "type": "string"
                  },
                  "is_merged": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "lessons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "lesson_index",
                "hours",
                "hours_raw",
                "is_hours_assumed",
                "hours_source_status",
                "learning_area",
                "topic_title",
                "topic_raw",
                "texts_and_materials",
