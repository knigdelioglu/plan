                "properties": {
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source_cell_range": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_merged": {
                    "type": "boolean"
                  }
                }
              },
              "social_emotional_learning_skills": {
                "type": "object",
                "required": [
                  "codes",
