                "properties": {
                  "text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source_cell_range": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_merged": {
                    "type": "boolean"
                  }
                }
              },
              "values": {
                "type": "object",
                "required": [
                  "codes",
                  "is_merged"
                ],
                "properties": {
                  "text": {
                    "type": [
                      "string",
