                    ]
                  },
                  "codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source_cell_range": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "is_merged": {
                    "type": "boolean"
                  }
                }
              },
              "literacy_skills": {
                "type": "object",
                "required": [
                  "codes",
                  "is_merged"
