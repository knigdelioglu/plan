{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meb.gov.tr/schemas/curriculum/grade-11-annual-plan.schema.json",
  "title": "Grade 11 Turkish Language and Literature Annual Plan Schema",
  "description": "JSON Schema for 11th Grade Turkish Language and Literature Annual Curriculum Framework Plan (Türkiye Yüzyılı Maarif Modeli).",
  "type": "object",
  "required": [
    "metadata",
    "general_explanations",
    "academic_calendar_breaks",
    "themes",
    "weeks"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "academic_year",
        "grade_level",
        "course_name",
        "school_type",
        "document_title",
        "source_file",
        "worksheet_name",
        "total_teaching_weeks",
        "weekly_lesson_hours",
        "verified_lesson_hours",
        "assumed_lesson_hours",
        "total_annual_hours_verified",
        "total_annual_hours_assumed",
        "hours_accounting",
        "source_range",
        "generated_at"
      ],
      "additionalProperties": true,
      "properties": {
        "academic_year": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}$"
        },
        "grade_level": {
          "type": "integer",
          "enum": [
            11
          ]
        },
        "course_name": {
          "type": "string"
        },
        "school_type": {
          "type": "string"
        },
        "document_title": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "worksheet_name": {
          "type": "string"
        },
        "total_teaching_weeks": {
          "type": "integer",
          "enum": [
            37
          ]
        },
        "weekly_lesson_hours": {
          "type": "integer",
          "enum": [
            5
          ]
        },
        "verified_lesson_hours": {
          "type": "integer",
          "enum": [
            180
          ]
        },
        "assumed_lesson_hours": {
          "type": "integer",
          "enum": [
            5
          ]
        },
        "total_annual_hours_verified": {
          "type": "integer",
          "enum": [
            180
          ]
        },
        "total_annual_hours_assumed": {
          "type": "integer",
          "enum": [
            185
          ]
        },
        "hours_accounting": {
          "type": "object"
        },
        "source_range": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "extractor_version": {
          "type": "string"
        },
        "archive_path_school_type_mismatch": {
          "type": "boolean",
          "description": "Depo klasörünün okul türü ile kaynak dosyanın okul türü eşleşmiyorsa true."
        },
        "archive_path_note": {
          "type": "string",
          "description": "Kaynak türü ile arşiv konumu arasındaki uyuşmazlığın açıklaması."
        }
      }
    },
    "general_explanations": {
      "type": "object",
      "required": [
        "differentiation",
        "school_based_planning"
      ],
      "additionalProperties": false,
      "properties": {
        "differentiation": {
          "type": "object",
          "required": [
            "title",
            "text",
            "source_cell_range",
            "anchor_cell",
            "is_merged"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "source_cell_range": {
              "type": "string"
            },
            "anchor_cell": {
              "type": "string"
            },
            "is_merged": {
              "type": "boolean"
            }
          }
        },
        "school_based_planning": {
          "type": "object",
          "required": [
            "title",
            "text",
            "source_cell_range",
            "anchor_cell",
            "is_merged"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "source_cell_range": {
              "type": "string"
            },
            "anchor_cell": {
              "type": "string"
            },
            "is_merged": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "academic_calendar_breaks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "break_name",
          "date_range_raw",
          "start_date",
          "end_date",
          "between_weeks",
          "source_row",
          "source_cell_range"
        ],
        "properties": {
          "break_name": {
            "type": "string"
          },
          "date_range_raw": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "between_weeks": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "source_row": {
            "type": "integer"
          },
          "source_cell_range": {
            "type": "string"
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "theme_number",
          "theme_code",
          "theme_name",
          "week_range",
          "total_hours",
          "assessment_and_evaluation",
          "interdisciplinary_components"
        ],
        "properties": {
          "theme_number": {
            "type": "integer"
          },
          "theme_code": {
            "type": "string"
          },
          "theme_name": {
            "type": "string"
          },
          "week_range": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "total_hours": {
            "type": "integer"
          },
          "assessment_and_evaluation": {
            "type": "object",
            "required": [
              "text",
              "source_cell_range"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "source_cell_range": {
                "type": "string"
              }
            }
          },
          "interdisciplinary_components": {
            "type": "object",
            "required": [
              "social_emotional_learning_skills",
              "values",
              "literacy_skills"
            ],
            "properties": {
              "social_emotional_learning_skills": {
                "type": "object",
                "required": [
                  "text",
                  "codes",
                  "source_cell_range"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source_cell_range": {
                    "type": "string"
                  }
                }
              },
              "values": {
                "type": "object",
                "required": [
                  "text",
                  "codes",
                  "source_cell_range"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source_cell_range": {
                    "type": "string"
                  }
                }
              },
              "literacy_skills": {
                "type": "object",
                "required": [
                  "text",
                  "codes",
                  "source_cell_range"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source_cell_range": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "items": {
        "type": "object",
        "required": [
          "week_number",
          "month",
          "date_range_raw",
          "start_date",
          "end_date",
          "total_hours",
          "hours_raw",
          "is_hours_assumed",
          "theme",
          "special_days_and_weeks",
          "pedagogical_context",
          "lessons",
          "source_metadata"
        ],
        "properties": {
          "week_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 37
          },
          "month": {
            "type": "string"
          },
          "date_range_raw": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "total_hours": {
            "type": "integer",
            "enum": [
              5
            ]
          },
          "hours_raw": {
            "type": "string"
          },
          "is_hours_assumed": {
            "type": "boolean"
          },
          "hours_source_verified": {
            "type": [
              "integer",
              "null"
            ]
          },
          "hours_assumed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "theme": {
            "type": "object",
            "required": [
              "theme_code",
              "theme_name"
            ],
            "properties": {
              "theme_number": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "theme_code": {
                "type": "string"
              },
              "theme_name": {
                "type": "string"
              }
            }
          },
          "special_days_and_weeks": {
            "type": "object",
            "required": [
              "present",
              "raw",
              "source_cell",
              "events",
              "has_calendar_discrepancy"
            ],
            "properties": {
              "present": {
                "type": "boolean"
              },
              "raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_cell": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "date_text",
                    "is_calendar_aligned",
                    "calendar_note"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "date_text": {
                      "type": "string"
                    },
                    "is_calendar_aligned": {
                      "type": "boolean",
                      "description": "Anma gününün literal tarihinin haftanın tarihleri içinde olup olmadığı. false değeri tek başına uygulama hatası anlamına gelmez."
                    },
                    "calendar_note": {
                      "type": "string"
                    },
                    "is_schedule_valid": {
                      "type": "boolean",
                      "description": "Takvimdeki anma günü haftayla çakışmasa da planlanan uygulama haftası doğrulanmış/geçerli olabilir."
                    },
                    "commemoration_date": {
                      "type": "string",
                      "description": "Günün özgün tarih adı; ör. 15 Temmuz."
                    },
                    "scheduled_week": {
                      "type": "integer",
                      "minimum": 1,
                      "description": "Etkinliğin okuldaki uygulama haftası; anma gününün takvim tarihiyle aynı olmak zorunda değildir."
                    },
                    "scheduled_date": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date",
                      "description": "Okuldaki kesin uygulama günü belirlenmediyse null."
                    },
                    "scheduling_status": {
                      "type": "string",
                      "description": "Planlı eğitim yılı başlangıç anması gibi özel yerleşim durumu."
                    },
                    "schedule_basis": {
                      "type": "string",
                      "description": "Takvim günü ile uygulama haftasının neden ayrıldığının açıklaması."
                    }
                  }
                }
              },
              "has_calendar_discrepancy": {
                "type": "boolean",
                "description": "Planlanmış okul içi uygulamayı hata sayma. Anma tarihinin haftayla eşleşmemesi tek başına takvim uyuşmazlığı değildir."
              },
              "calendar_discrepancy_note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scheduling_note": {
                "type": "string",
                "description": "Özel günün yıllık planda hangi nedenle bu haftaya yerleştirildiği; resmi tarih ile ders haftası ayrımı."
              }
            }
          },
          "pedagogical_context": {
            "type": "object",
            "required": [
              "assessment_and_evaluation",
              "social_emotional_learning_skills",
              "values",
              "literacy_skills",
              "differentiation",
              "school_based_planning_framework"
