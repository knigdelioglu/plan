{
  "expo": {
    "name": "Haftalık Plan",
    "slug": "haftalik-plan",
    "scheme": "haftalikplan",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F8FA",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "stream.sunum.plan"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
