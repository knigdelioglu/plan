{
  "version": 3,
  "description": "Kaynak yıllık plan JSON arşivinin veri ve kök belge çalışma sınırları.",
  "scopes": {
    "data": {
      "write": [
        "plans/**"
      ],
      "read": [
        "plans/**"
      ],
      "agent_file": "plans/AGENTS.md"
    },
    "shared": {
      "write_policy": "explicit-user-request-only",
      "paths": [
        "AGENTS.md",
        "README.md",
        "SCOPES.md",
        ".scope.json"
      ]
    }
  },
  "policy": {
    "scope": "data-only",
    "application_workspace": false,
    "shared_metadata_requires_explicit_request": true
  }
}
