{
  "version": 2,
  "description": "Yıllık plan arşivi ile React Native + Expo mobil uygulaması arasında ayrı yazma kapsamları.",
  "scopes": {
    "data": {
      "write": [
        "plans/**"
      ],
      "read": [
        "plans/**"
      ],
      "deny_write": [
        "mobile/**"
      ],
      "agent_file": "plans/AGENTS.md"
    },
    "mobile": {
      "write": [
        "mobile/**"
      ],
      "read": [
        "mobile/**",
        "plans/**"
      ],
      "deny_write": [
        "plans/**"
      ],
      "agent_file": "mobile/AGENTS.md"
    },
    "shared": {
      "write_policy": "explicit-user-request-only",
      "paths": [
        "AGENTS.md",
        "README.md",
        "SCOPES.md",
        ".scope.json",
        ".github/**"
      ]
    }
  },
  "policy": {
    "no_cross_scope_writes": true,
    "mixed_scope_changes": "separate-prs",
    "read_only_cross_scope_access": true
  }
}
