{
  "version": 4,
  "description": "Kaynak yıllık plan JSON arşivi ve Android Native uygulama çalışma sınırları.",
  "scopes": {
    "data": {
      "write": [
        "plans/**"
      ],
      "read": [
        "plans/**"
      ],
      "agent_file": "plans/AGENTS.md"
    },
    "android": {
      "write": [
        "android/**"
      ],
      "read": [
        "android/**",
        "plans/**"
      ],
      "agent_file": "android/AGENTS.md"
    },
    "shared": {
      "write_policy": "explicit-user-request-only",
      "paths": [
        "AGENTS.md",
        "README.md",
        "SCOPES.md",
        ".scope.json"
      ]
    }
  },
  "policy": {
    "scope": "multi-workspace",
    "application_workspace": true,
    "plans_archive_read_only_for_app": true,
    "shared_metadata_requires_explicit_request": true
  }
}
